From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Sun, 11 Oct 2026 21:42:52 +1300
Subject: [PATCH] internal/syscall/windows: wait for a deleted name its last handle is about to release

Deleteat (CL 713480, Go 1.26) and RemoveAll above it count on POSIX delete
semantics taking a name away at once. Where the kernel lacks them, a name
marked for deletion stays until the last handle to it closes, every open of
it answers STATUS_DELETE_PENDING until then, and a directory that holds
only such names is refused as not empty. A handle another process keeps on
a directory for a moment is enough, and the os.Root comparison tests meet
one on Windows 7, the cleanup of their temporary directory finding the
emptied directory still there.

	delete a held directory  ->  name stays, STATUS_DELETE_PENDING
	RemoveAll of its parent  ->  ERROR_DIR_NOT_EMPTY  ->  fails
	                             while the holder is about to close

Deleteat waits in two places, every millisecond for up to 100 ms. An open
that answers STATUS_DELETE_PENDING is tried again, and a directory refused
as not empty is listed and tried again while every entry in it answers that
status. A holder that keeps the name longer gets the kernel's answer after
the wait, where Windows 10 and later would have removed the name at once.
Neither wait needs a gate, because only a kernel that keeps names ever
answers so.

diff --git a/src/internal/syscall/windows/at_windows.go b/src/internal/syscall/windows/at_windows.go
index 82dcdd19..4aea2c79 100644
--- a/src/internal/syscall/windows/at_windows.go
+++ b/src/internal/syscall/windows/at_windows.go
@@ -322,7 +322,7 @@ func Deleteat(dirfd syscall.Handle, name string, options uint32) error {
 	}
 	var h syscall.Handle
 	var err error
-	var again waiter
+	var again, pending waiter
 	for {
 		err = NtOpenFile(
 			&h,
@@ -350,6 +350,14 @@ func Deleteat(dirfd syscall.Handle, name string, options uint32) error {
 		if err == STATUS_SHARING_VIOLATION && imageWait() && again.again() {
 			continue
 		}
+		// An entry marked for deletion keeps its name until the last handle
+		// to it closes, on a kernel without POSIX delete semantics, and
+		// answers this until then. Only such a kernel ever answers it, and
+		// the name goes the moment that handle closes, so wait for it a
+		// moment. See waiter.
+		if err == STATUS_DELETE_PENDING && pending.again() {
+			continue
+		}
 		break
 	}
 	if err != nil {
@@ -506,7 +514,7 @@ func deleteatFallback(h syscall.Handle, objAttrs *OBJECT_ATTRIBUTES, name string
 		setAsideForDelete(h, objAttrs, &data)
 
 	var err error
-	var again waiter
+	var again, pending waiter
 	for {
 		err = SetFileInformationByHandle(
 			h,
@@ -522,6 +530,12 @@ func deleteatFallback(h syscall.Handle, objAttrs *OBJECT_ATTRIBUTES, name string
 		if err == syscall.ERROR_ACCESS_DENIED && imageWait() && again.again() {
 			continue
 		}
+		// A directory whose every entry is marked for deletion is empty
+		// but for the handles that keep those names, and the names go the
+		// moment they close. Wait for that a moment. See waiter.
+		if err == syscall.ERROR_DIR_NOT_EMPTY && haveData && onlyDeletePending(objAttrs, &data) && pending.again() {
+			continue
+		}
 		break
 	}
 	if err != nil && aside {
@@ -578,6 +592,82 @@ func (w *waiter) again() bool {
 	return true
 }
 
+// onlyDeletePending reports whether every entry the directory at objAttrs,
+// whose identity is in data, still holds is marked for deletion, kept only
+// by a handle that has yet to close. The directory is
+// opened again by name with the right to list it, which the handle Deleteat
+// holds was opened without, and only an entry with the same identity is
+// listed. Each entry is then opened, and one that answers anything but
+// STATUS_DELETE_PENDING ends the search. Windows 10 and later answer
+// STATUS_OBJECT_NAME_NOT_FOUND for such an entry while still listing it,
+// which is the same thing said differently.
+func onlyDeletePending(objAttrs *OBJECT_ATTRIBUTES, data *syscall.ByHandleFileInformation) bool {
+	var dir syscall.Handle
+	err := NtOpenFile(
+		&dir,
+		SYNCHRONIZE|FILE_LIST_DIRECTORY|FILE_READ_ATTRIBUTES,
+		objAttrs,
+		&IO_STATUS_BLOCK{},
+		FILE_SHARE_DELETE|FILE_SHARE_READ|FILE_SHARE_WRITE,
+		FILE_OPEN_REPARSE_POINT|FILE_OPEN_FOR_BACKUP_INTENT|FILE_DIRECTORY_FILE|FILE_SYNCHRONOUS_IO_NONALERT,
+	)
+	if err != nil {
+		return false
+	}
+	defer syscall.CloseHandle(dir)
+	var again syscall.ByHandleFileInformation
+	if syscall.GetFileInformationByHandle(dir, &again) != nil ||
+		again.VolumeSerialNumber != data.VolumeSerialNumber ||
+		again.FileIndexHigh != data.FileIndexHigh || again.FileIndexLow != data.FileIndexLow {
+		return false
+	}
+	// The entries carry 64-bit fields, and the call refuses a buffer that
+	// is not aligned for them.
+	var buf [512]uint64
+	for {
+		err := GetFileInformationByHandleEx(dir, FileIdBothDirectoryInfo, (*byte)(unsafe.Pointer(&buf[0])), uint32(unsafe.Sizeof(buf)))
+		if err == syscall.ERROR_NO_MORE_FILES {
+			// Nothing the listing can see, yet the delete was refused as
+			// not empty: the entry went between the two calls, or this
+			// kernel hides an entry marked for deletion from a listing
+			// while still counting it, as Windows 10 and later do.
+			return true
+		}
+		if err != nil {
+			return false
+		}
+		for off := uint32(0); ; {
+			info := (*FILE_ID_BOTH_DIR_INFO)(unsafe.Add(unsafe.Pointer(&buf[0]), off))
+			name := unsafe.Slice(&info.FileName[0], info.FileNameLength/2)
+			if !(len(name) == 1 && name[0] == '.') && !(len(name) == 2 && name[0] == '.' && name[1] == '.') {
+				entryAttrs := &OBJECT_ATTRIBUTES{}
+				if err := entryAttrs.init(dir, syscall.UTF16ToString(name)); err != nil {
+					return false
+				}
+				var eh syscall.Handle
+				err := NtOpenFile(
+					&eh,
+					FILE_READ_ATTRIBUTES,
+					entryAttrs,
+					&IO_STATUS_BLOCK{},
+					FILE_SHARE_DELETE|FILE_SHARE_READ|FILE_SHARE_WRITE,
+					FILE_OPEN_REPARSE_POINT|FILE_OPEN_FOR_BACKUP_INTENT,
+				)
+				if err == nil {
+					syscall.CloseHandle(eh)
+				}
+				if err != STATUS_DELETE_PENDING && err != STATUS_OBJECT_NAME_NOT_FOUND {
+					return false
+				}
+			}
+			if info.NextEntryOffset == 0 {
+				break
+			}
+			off += info.NextEntryOffset
+		}
+	}
+}
+
 // deleteStagingDir is a directory to park a file that cannot go away at once,
 // with the volume it sits on. Parking a file there takes it out of the tree a
 // caller is removing.
diff --git a/src/internal/syscall/windows/syscall_windows.go b/src/internal/syscall/windows/syscall_windows.go
index 1ab7673d..1d58d089 100644
--- a/src/internal/syscall/windows/syscall_windows.go
+++ b/src/internal/syscall/windows/syscall_windows.go
@@ -570,6 +570,8 @@ const (
 	STATUS_NOT_A_DIRECTORY           NTStatus = 0xC0000103
 	STATUS_CANNOT_DELETE             NTStatus = 0xC0000121
 	STATUS_SHARING_VIOLATION         NTStatus = 0xC0000043
+	STATUS_DELETE_PENDING            NTStatus = 0xC0000056
+	STATUS_OBJECT_NAME_NOT_FOUND     NTStatus = 0xC0000034
 	STATUS_REPARSE_POINT_ENCOUNTERED NTStatus = 0xC000050B
 	STATUS_NOT_SUPPORTED             NTStatus = 0xC00000BB
 	STATUS_INVALID_PARAMETER         NTStatus = 0xC000000D
diff --git a/src/os/path_windows_test.go b/src/os/path_windows_test.go
index f747aa50..a80f4417 100644
--- a/src/os/path_windows_test.go
+++ b/src/os/path_windows_test.go
@@ -441,6 +441,63 @@ func TestRemoveAllFallbackOpenFile(t *testing.T) {
 	}
 }
 
+// TestRemoveAllWaitsForDeletePending covers the waits Deleteat makes for an
+// entry marked for deletion whose holder is about to close. Windows 7, 8 and
+// 8.1 keep such a directory's name until the last handle closes and refuse
+// to rename it, so RemoveAll of its parent finds it not empty, which the
+// os.Root comparison tests met on a Windows 8.1 guest. There are two shapes: the entry was
+// deleted before RemoveAll came, and every open of it answers delete
+// pending; or RemoveAll deleted it itself, and the parent then refuses as
+// not empty while every entry left in it is pending. Windows 11 drops the
+// name at once, so there neither wait is entered and the test passes with
+// or without them; on the kernels that keep names it fails without them.
+// Only the fallback is covered, which is the only path on those kernels.
+func TestRemoveAllWaitsForDeletePending(t *testing.T) {
+	windows.TestDeleteatFallback = true
+	t.Cleanup(func() { windows.TestDeleteatFallback = false })
+
+	for _, tt := range []struct {
+		name          string
+		deletedBefore bool
+	}{
+		{"deleted before RemoveAll", true},
+		{"deleted by RemoveAll", false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			parent := filepath.Join(t.TempDir(), "parent")
+			dir := filepath.Join(parent, "held")
+			if err := os.MkdirAll(dir, 0777); err != nil {
+				t.Fatal(err)
+			}
+			p, err := syscall.UTF16PtrFromString(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			h, err := syscall.CreateFile(p, syscall.GENERIC_READ,
+				syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE|syscall.FILE_SHARE_DELETE, nil,
+				syscall.OPEN_EXISTING, syscall.FILE_FLAG_BACKUP_SEMANTICS, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tt.deletedBefore {
+				// Where the kernel keeps the name, the directory is now
+				// there and answers delete pending to every open.
+				if err := os.Remove(dir); err != nil {
+					syscall.CloseHandle(h)
+					t.Fatalf("Remove of a held empty directory = %v, want nil", err)
+				}
+			}
+			time.AfterFunc(20*time.Millisecond, func() { syscall.CloseHandle(h) })
+			if err := os.RemoveAll(parent); err != nil {
+				t.Fatalf("RemoveAll of the parent = %v, want nil once the holder let go", err)
+			}
+			if _, err := os.Lstat(parent); !errors.Is(err, fs.ErrNotExist) {
+				t.Errorf("Lstat after RemoveAll = %v, want ErrNotExist", err)
+			}
+		})
+	}
+}
+
