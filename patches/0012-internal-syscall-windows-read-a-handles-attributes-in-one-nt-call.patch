-		if err != nil {
+	if info, err := fileAttributesAndTag(h); err == nil && info.FileAttributes&syscall.FILE_ATTRIBUTE_READONLY != 0 {
+		if err := clearReadOnly(h, objAttrs, info.FileAttributes); err != nil {
