From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 18:34:28 +1300
Subject: [PATCH] syscall, internal/syscall/windows: close temporary sockets with closesocket

Backported from upstream (CL 828685, commit 00be0f2, Go 1.28).

syscall.LoadConnectEx and windows.loadWSASendRecvMsg close the socket they
look up a function on with CloseHandle, which skips Winsock's cleanup, so a
later socket given the same handle value can carry the old one's state.

Stop FileConn, FileListener and FilePacketConn failing now and then, on
every Windows.
Close those sockets with Closesocket.

	                       before                 after
	-----------------------------------------------------------------------
	Windows 7 to 11        FileConn,              never fail
	                       FileListener and
	                       FilePacketConn fail
	                       now and then, WSAEINVAL

Gate: none | Remembered: N/A

diff --git a/src/internal/poll/fd_windows_test.go b/src/internal/poll/fd_windows_test.go
index 6d6fbaf0..e2123b33 100644
--- a/src/internal/poll/fd_windows_test.go
+++ b/src/internal/poll/fd_windows_test.go
@@ -30,7 +30,7 @@ func TestWSASocketConflict(t *testing.T) {
 	}
 	fd := poll.FD{Sysfd: s, IsStream: true, ZeroReadIsEOF: true}
 	if err = fd.Init("tcp", true); err != nil {
-		syscall.CloseHandle(s)
+		syscall.Closesocket(s)
 		t.Fatal(err)
 	}
 	defer fd.Close()
diff --git a/src/internal/syscall/windows/syscall_windows.go b/src/internal/syscall/windows/syscall_windows.go
index ab292313..aa2ef794 100644
--- a/src/internal/syscall/windows/syscall_windows.go
+++ b/src/internal/syscall/windows/syscall_windows.go
@@ -281,7 +281,7 @@ func loadWSASendRecvMsg() error {
 		if sendRecvMsgFunc.err != nil {
 			return
 		}
-		defer syscall.CloseHandle(s)
+		defer syscall.Closesocket(s)
 		var n uint32
 		sendRecvMsgFunc.err = syscall.WSAIoctl(s,
 			syscall.SIO_GET_EXTENSION_FUNCTION_POINTER,
diff --git a/src/syscall/syscall_windows.go b/src/syscall/syscall_windows.go
index fad0e497..ea3bca0a 100644
--- a/src/syscall/syscall_windows.go
+++ b/src/syscall/syscall_windows.go
@@ -1423,7 +1423,7 @@ func LoadConnectEx() error {
 		if connectExFunc.err != nil {
 			return
 		}
-		defer CloseHandle(s)
+		defer Closesocket(s)
 		var n uint32
 		connectExFunc.err = WSAIoctl(s,
 			SIO_GET_EXTENSION_FUNCTION_POINTER,
