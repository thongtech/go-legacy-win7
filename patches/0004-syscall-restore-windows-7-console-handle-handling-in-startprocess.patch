From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 11:52:32 +1300
Subject: [PATCH] syscall: restore Windows 7 console handle handling in StartProcess

On Windows 7 a console handle is a tagged value only its own process
understands. Since Go 1.17 StartProcess passes the standard handles in the
list a child inherits (CL 288297, commit 2d76081), and Go 1.22 deleted the
workaround that kept such handles out of it (CL 531235, commit 48042aa).

Let programs, the go command included, start child processes from a Windows
7 console. Restore the workaround as Go 1.21 had it.

	                       before                 after
	-----------------------------------------------------------------------
	Windows 7              starting a child       the child starts
	                       fails, "Insufficient
	                       system resources"
	-----------------------------------------------------------------------
	Windows 8 and later    the child starts       the child starts

Gate: version (Windows 7 and older) | Remembered: N

diff --git a/src/syscall/exec_windows.go b/src/syscall/exec_windows.go
index 96089fcd..09f45f85 100644
--- a/src/syscall/exec_windows.go
+++ b/src/syscall/exec_windows.go
@@ -367,6 +367,17 @@ func StartProcess(argv0 string, argv []string, attr *ProcAttr) (pid int, handle
 		}
 	}
 
+	var maj, min, build uint32
+	rtlGetNtVersionNumbers(&maj, &min, &build)
+	isWin7 := maj < 6 || (maj == 6 && min <= 1)
+	// NT kernel handles are divisible by 4, with the bottom 3 bits left as
+	// a tag. The fully set tag correlates with the types of handles we're
+	// concerned about here.  Except, the kernel will interpret some
+	// special handle values, like -1, -2, and so forth, so kernelbase.dll
+	// checks to see that those bottom three bits are checked, but that top
+	// bit is not checked.
+	isLegacyWin7ConsoleHandle := func(handle Handle) bool { return isWin7 && handle&0x10000003 == 3 }
+
 	p, _ := GetCurrentProcess()
 	parentProcess := p
 	if sys.ParentProcess != 0 {
@@ -375,7 +386,15 @@ func StartProcess(argv0 string, argv []string, attr *ProcAttr) (pid int, handle
 	fd := make([]Handle, len(attr.Files))
 	for i := range attr.Files {
 		if attr.Files[i] > 0 {
-			err := DuplicateHandle(p, Handle(attr.Files[i]), parentProcess, &fd[i], 0, true, DUPLICATE_SAME_ACCESS)
+			destinationProcessHandle := parentProcess
+
+			// On Windows 7, console handles aren't real handles, and can only be duplicated
+			// into the current process, not a parent one, which amounts to the same thing.
+			if parentProcess != p && isLegacyWin7ConsoleHandle(Handle(attr.Files[i])) {
+				destinationProcessHandle = p
+			}
+
+			err := DuplicateHandle(p, Handle(attr.Files[i]), destinationProcessHandle, &fd[i], 0, true, DUPLICATE_SAME_ACCESS)
 			if err != nil {
 				return 0, 0, err
 			}
@@ -406,6 +425,14 @@ func StartProcess(argv0 string, argv []string, attr *ProcAttr) (pid int, handle
 
 	fd = append(fd, sys.AdditionalInheritedHandles...)
 
+	// On Windows 7, console handles aren't real handles, so don't pass them
+	// through to PROC_THREAD_ATTRIBUTE_HANDLE_LIST.
+	for i := range fd {
+		if isLegacyWin7ConsoleHandle(fd[i]) {
+			fd[i] = 0
+		}
+	}
+
 	// The presence of a NULL handle in the list is enough to cause PROC_THREAD_ATTRIBUTE_HANDLE_LIST
 	// to treat the entire list as empty, so remove NULL handles.
 	j := 0
diff --git a/src/syscall/exec_windows_test.go b/src/syscall/exec_windows_test.go
index 60a995e4..e50f345b 100644
--- a/src/syscall/exec_windows_test.go
+++ b/src/syscall/exec_windows_test.go
@@ -146,3 +146,20 @@ func TestChangingProcessParent(t *testing.T) {
 		t.Fatalf("child output: want %q, got %q", want, got)
 	}
 }
+
+// TestStartProcessConsoleHandle checks that a child can be started with a
+// console handle as its standard output. Before Windows 8 a console handle is
+// a pseudo-handle, which CreateProcess refuses in the inherited handle list.
+func TestStartProcessConsoleHandle(t *testing.T) {
+	testenv.MustHaveExec(t)
+	con, err := os.OpenFile("CONOUT$", os.O_WRONLY, 0)
+	if err != nil {
+		t.Skipf("no console to open: %v", err)
+	}
+	defer con.Close()
+	cmd := exec.Command("cmd", "/c", "rem")
+	cmd.Stdout = con
+	if err := cmd.Run(); err != nil {
+		t.Fatal(err)
+	}
+}
