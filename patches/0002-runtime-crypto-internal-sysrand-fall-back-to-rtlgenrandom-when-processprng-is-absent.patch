From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Fri, 04 Sep 2026 20:04:27 +1200
Subject: [PATCH] runtime, crypto/internal/sysrand: fall back to RtlGenRandom when ProcessPrng is absent

The runtime and crypto/rand ask the operating system for random bytes.
CL 536235 (Go 1.22, and 1.21.5 by backport) switched both from RtlGenRandom to
ProcessPrng. Windows 7 ships the DLL that exports ProcessPrng, but not the
function, which was added in Windows 8.

	                Win7 RTM   Windows 8 and later
	ProcessPrng     missing    present
	RtlGenRandom    present    present

	runtime      ->  readRandom calls a nil pointer in schedinit
	crypto/rand  ->  the read fails  ->  panic

Look up RtlGenRandom in advapi32.dll when ProcessPrng is missing, and read from
whichever one was found. The choice depends on what GetProcAddress returns, not
on the Windows version. crypto/internal/sysrand reads at most 1<<31-1 bytes per
call, as crypto/rand did before the switch.


diff --git a/src/crypto/internal/sysrand/rand_windows.go b/src/crypto/internal/sysrand/rand_windows.go
index 91f1490c..e164a38c 100644
--- a/src/crypto/internal/sysrand/rand_windows.go
+++ b/src/crypto/internal/sysrand/rand_windows.go
@@ -4,8 +4,38 @@
 
 package sysrand
 
-import "internal/syscall/windows"
+import (
+	"internal/syscall/windows"
+	"sync"
+)
+
+// ProcessPrng is only available since Windows 8. Fall back to RtlGenRandom,
+// which every earlier version exports from advapi32.dll.
+var useProcessPrng = sync.OnceValue(func() bool {
+	return windows.ErrorLoadingProcessPrng() == nil
+})
 
 func read(b []byte) error {
-	return windows.ProcessPrng(b)
+	if useProcessPrng() {
+		return windows.ProcessPrng(b)
+	}
+	return readBatched(b, 1<<31-1)
+}
+
+// readBatched fills b through RtlGenRandom, whose length is a ULONG. A
+// longer buffer would be truncated to its low 32 bits and the rest left
+// as it was, reported as a success. Read max bytes at a time. ProcessPrng
+// takes a SIZE_T and needs none of this.
+func readBatched(b []byte, max int) error {
+	for len(b) > 0 {
+		chunk := b
+		if len(chunk) > max {
+			chunk = chunk[:max]
+		}
+		if err := windows.RtlGenRandom(chunk); err != nil {
+			return err
+		}
+		b = b[len(chunk):]
+	}
+	return nil
 }
diff --git a/src/crypto/internal/sysrand/rand_windows_test.go b/src/crypto/internal/sysrand/rand_windows_test.go
new file mode 100644
index 00000000..ed26983b
--- /dev/null
+++ b/src/crypto/internal/sysrand/rand_windows_test.go
@@ -0,0 +1,26 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package sysrand
+
+import "testing"
+
+// TestReadBatched checks that a buffer longer than one RtlGenRandom call
+// may take is filled to its end. The real limit is 1<<31-1, too large to
+// allocate here, so a small one stands in for it.
+func TestReadBatched(t *testing.T) {
+	b := make([]byte, 1000)
+	if err := readBatched(b, 7); err != nil {
+		t.Fatal(err)
+	}
+	// The tail lies well past the first chunk, so it is only written if
+	// the loop advanced. All zeroes there means it did not.
+	tail := b[len(b)-32:]
+	for _, c := range tail {
+		if c != 0 {
+			return
+		}
+	}
+	t.Error("the end of the buffer was left unwritten")
+}
