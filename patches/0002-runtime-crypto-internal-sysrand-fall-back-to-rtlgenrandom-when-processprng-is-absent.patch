+
+// ReadRandomFromRtlGenRandom reads through RtlGenRandom, loaded the way
+// loadOptionalSyscalls loads it when ProcessPrng is unavailable.
+func ReadRandomFromRtlGenRandom(r []byte) int {
+	fn := loadRtlGenRandom()
+	if fn == nil {
+		return 0
+	}
+	return readRandomFrom(fn, r)
+}
