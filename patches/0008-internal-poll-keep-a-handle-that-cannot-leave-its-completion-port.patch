From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 12:53:10 +1300
Subject: [PATCH] internal/poll: keep a handle that cannot leave its completion port

Go waits for network I/O through one I/O completion port. Since Go 1.25
Conn.File and Listener.File take the socket off that port (CL 668195,
commit 6953ef8, through CL 664455, commit 8a8f506), which only Windows 8.1
and later can do.

Let Conn.File and Listener.File work on Windows 7 and 8. On those systems
leave the socket on the port, where it keeps working, Close included.

	                       before                 after
	-----------------------------------------------------------------------
	Windows 7, 8           Conn.File and          both work
	                       Listener.File fail
	-----------------------------------------------------------------------
	Windows 8.1 and later  both work              both work

Gate: version (8.1 and later) | Remembered: Y

diff --git a/src/internal/poll/fd_windows.go b/src/internal/poll/fd_windows.go
index 2e4b97cf..e077f388 100644
--- a/src/internal/poll/fd_windows.go
+++ b/src/internal/poll/fd_windows.go
@@ -330,7 +330,7 @@ func (fd *FD) execIO(mode int, submit func(o *operation) (uint32, error)) (int,
 		if waitErr != nil {
 			// IO canceled by the poller while waiting for completion.
 			err = waitErr
-		} else if fd.kind == kindPipe && fd.closing() {
+		} else if (fd.kind == kindPipe || fd.offPoller()) && fd.closing() {
 			// Close uses CancelIoEx to interrupt concurrent I/O for pipes.
 			// If the fd is a pipe and the Write was interrupted by CancelIoEx,
 			// we assume it is interrupted by Close.
@@ -494,7 +494,12 @@ func (fd *FD) Init(net string, pollable bool) error {
 	// I/O completion notifications not initiated by us.
 	err := fd.pd.init(fd)
 	if err != nil {
-		return err
+		if err != windows.ERROR_INVALID_PARAMETER || canDetachFromIOCP() {
+			return err
+		}
+		// This kernel cannot take the socket off its port. Leave it
+		// there and drive it with an event.
+		return nil
 	}
 	if !fd.KeepFileCompletionModes && (fd.kind != kindNet || socketCanUseSetFileCompletionNotificationModes) {
 		// Non-socket handles can use SetFileCompletionNotificationModes without problems.
@@ -506,6 +511,32 @@ func (fd *FD) Init(net string, pollable bool) error {
 	return nil
 }
 
+// offPoller reports whether fd does overlapped I/O outside the poller on a
+// kernel that cannot detach, where only CancelIoEx ends a wait.
+func (fd *FD) offPoller() bool {
+	return !fd.isBlocking && fd.pd.runtimeCtx == 0 && !canDetachFromIOCP()
+}
+
+// canDetachFromIOCP reports whether the kernel has
+// FileReplaceCompletionInformation (from Windows 8.1), the only way to take a
+// handle off a completion port.
+func canDetachFromIOCP() bool {
+	if TestDisassociateIOCPUnsupported {
+		return false
+	}
+	return detachFromIOCPSupported()
+}
+
+var detachFromIOCPSupported = sync.OnceValue(func() bool {
+	major, minor, _ := windows.KernelVersion()
+	return major > 6 || (major == 6 && minor >= 3)
+})
+
+// TestDisassociateIOCPUnsupported should only be used for testing purposes.
+// When set, [FD.DisassociateIOCP] behaves as it does on a kernel without
+// FileReplaceCompletionInformation.
+var TestDisassociateIOCPUnsupported bool
+
 // DisassociateIOCP disassociates the file handle from the IOCP.
 // The disassociate operation will not succeed if there is any
 // in-progress IO operation on the file handle.
@@ -520,6 +551,13 @@ func (fd *FD) DisassociateIOCP() error {
 		return nil
 	}
 
+	if !canDetachFromIOCP() {
+		// It cannot come off the port. Count it as off, so that its
+		// I/O is driven with an event from here on.
+		fd.disassociated.Store(true)
+		return nil
+	}
+
 	info := windows.FILE_COMPLETION_INFORMATION{}
 	if err := windows.NtSetInformationFile(fd.Sysfd, &windows.IO_STATUS_BLOCK{}, unsafe.Pointer(&info), uint32(unsafe.Sizeof(info)), windows.FileReplaceCompletionInformation); err != nil {
 		return err
@@ -557,7 +595,8 @@ func (fd *FD) Close() error {
 		return errClosing(fd.isFile)
 	}
 
-	if fd.kind == kindPipe {
+	if fd.kind == kindPipe || fd.offPoller() {
+		// Nothing else ends a wait on a handle the poller does not watch.
 		syscall.CancelIoEx(fd.Sysfd, nil)
 	}
 	// unblock pending reader and writer
diff --git a/src/net/file_windows_test.go b/src/net/file_windows_test.go
new file mode 100644
index 00000000..97bd11a7
--- /dev/null
+++ b/src/net/file_windows_test.go
@@ -0,0 +1,68 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package net
+
+import (
+	"internal/poll"
+	"testing"
+	"time"
+)
+
+// TestFileNoDisassociateIOCPClose checks that Close ends a Read on a
+// connection the poller could not adopt.
+func TestFileNoDisassociateIOCPClose(t *testing.T) {
+	poll.TestDisassociateIOCPUnsupported = true
+	t.Cleanup(func() { poll.TestDisassociateIOCPUnsupported = false })
+
+	ln := newLocalListener(t, "tcp")
+	defer ln.Close()
+	c, err := Dial(ln.Addr().Network(), ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	server, err := ln.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	f, err := c.(*TCPConn).File()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	dup, err := FileConn(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	read := make(chan error, 1)
+	go func() {
+		_, err := dup.Read(make([]byte, 1))
+		read <- err
+	}()
+	// Let the Read get as far as waiting. If it has not, Close still has to
+	// refuse it, and either way it must come back.
+	time.Sleep(50 * time.Millisecond)
+	closed := make(chan error, 1)
+	go func() { closed <- dup.Close() }()
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Errorf("Close = %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("Close did not return while a Read was pending")
+	}
+	select {
+	case err := <-read:
+		if err == nil {
+			t.Error("Read returned no error after Close")
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("Read did not return after Close")
+	}
+}
