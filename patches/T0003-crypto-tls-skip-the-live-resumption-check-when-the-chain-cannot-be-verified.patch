From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 19:45:08 +1300
Subject: [PATCH] crypto/tls: skip the live resumption check when the chain cannot be verified

TestRealResumption (CL 741361, commit b691a2e, Go 1.27) revalidates the
whole chain of yahoo.com, which ends at DigiCert Global Root G2. The store
Windows 7 shipped with lacks that root, and an offline system never fetches
it.

Keep the test from failing on a root store that cannot verify the chain.
Skip it when no connection can verify the chain.

	                       before                 after
	-----------------------------------------------------------------------
	offline Windows 7      fails, nothing         skips, says why
	                       resumed
	-----------------------------------------------------------------------
	with the root          passes                 passes

Gate: query (a dial verifies, each run) | Remembered: N

diff --git a/src/crypto/tls/tls_test.go b/src/crypto/tls/tls_test.go
index 6fe44907..1824c6bc 100644
--- a/src/crypto/tls/tls_test.go
+++ b/src/crypto/tls/tls_test.go
@@ -613,12 +613,22 @@ func TestRealResumption(t *testing.T) {
 		ClientSessionCache: NewLRUClientSessionCache(0),
 	}
 
+	// The root store of Windows 7 lacks some roots this server chains to.
+	// Count verification failures to tell that apart from a failure to
+	// resume.
+	var handshakes, verifyFailures int
+
 	for range 10 {
 		conn, err := Dial("tcp", "yahoo.com:443", config)
 		if err != nil {
 			t.Log("Dial error:", err)
+			var verr *CertificateVerificationError
+			if errors.As(err, &verr) {
+				verifyFailures++
+			}
 			continue
 		}
+		handshakes++
 		// Do a read to consume the NewSessionTicket messages.
 		fmt.Fprintf(conn, "GET / HTTP/1.1\r\nHost: yahoo.com\r\nConnection: close\r\n\r\n")
 		conn.Read(make([]byte, 4096))
@@ -627,8 +637,13 @@ func TestRealResumption(t *testing.T) {
 		conn, err = Dial("tcp", "yahoo.com:443", config)
 		if err != nil {
 			t.Log("second Dial error:", err)
+			var verr *CertificateVerificationError
+			if errors.As(err, &verr) {
+				verifyFailures++
+			}
 			continue
 		}
+		handshakes++
 		state := conn.ConnectionState()
 		conn.Close()
 
@@ -637,6 +652,12 @@ func TestRealResumption(t *testing.T) {
 		}
 	}
 
+	if handshakes == 0 && verifyFailures > 0 {
+		// No dial verified, so this says nothing about resumption,
+		// which TestResumption covers locally.
+		t.Skipf("%d of 10 dials failed to verify the chain and none completed; the host's trust store does not carry the root it ends at", verifyFailures)
+	}
+
 	t.Fatal("no connection used session resumption")
 }
 
