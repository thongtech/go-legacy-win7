From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 11:09:23 +1300
Subject: [PATCH] cmd/link, syscall: set PE minimum target version to Windows 7

Every Windows program records the oldest Windows it can run on. Go 1.27
raised that from version 6.1, Windows 7, to 10.0, Windows 10 (CL 756680,
commit 341b5e2), and Windows 7, 8 and 8.1 refuse to start such a program.

Let Go 1.27 programs start on Windows 7, 8 and 8.1 again. Stamp 6.1 again.
Windows 8.1 and later report themselves as Windows 8 to a program stamped
that way, so syscall.GetVersion now asks for the real version instead.

	                       before                 after
	-----------------------------------------------------------------------
	Windows 7, 8, 8.1      program refused,       program runs
	                       "Access is denied"
	-----------------------------------------------------------------------
	Windows 10, 11         program runs           program runs

Gate: none | Remembered: N/A

diff --git a/src/cmd/link/internal/ld/pe.go b/src/cmd/link/internal/ld/pe.go
index 8376ddef..bdbf4b1e 100644
--- a/src/cmd/link/internal/ld/pe.go
+++ b/src/cmd/link/internal/ld/pe.go
@@ -281,9 +281,11 @@ type IMAGE_LOAD_CONFIG_DIRECTORY64 struct {
 	GuardMemcpyFunctionPointer               uint64
 }
 
+// The loaders of Windows 7, 8 and 8.1 refuse an image stamped for a newer
+// Windows.
 const (
-	PeMinimumTargetMajorVersion = 10
-	PeMinimumTargetMinorVersion = 0
+	PeMinimumTargetMajorVersion = 6
+	PeMinimumTargetMinorVersion = 1
 )
 
 // DOS stub that prints out
diff --git a/src/syscall/syscall_windows.go b/src/syscall/syscall_windows.go
index b1062e14..b273b45b 100644
--- a/src/syscall/syscall_windows.go
+++ b/src/syscall/syscall_windows.go
@@ -251,7 +251,7 @@ func NewCallbackCDecl(fn any) uintptr {
 //sys	LoadLibrary(libname string) (handle Handle, err error) = LoadLibraryW
 //sys	FreeLibrary(handle Handle) (err error)
 //sys	GetProcAddress(module Handle, procname string) (proc uintptr, err error)
-//sys	GetVersion() (ver uint32, err error)
+//sys	rtlGetNtVersionNumbers(majorVersion *uint32, minorVersion *uint32, buildNumber *uint32) = ntdll.RtlGetNtVersionNumbers
 //sys	formatMessage(flags uint32, msgsrc uintptr, msgid uint32, langid uint32, buf []uint16, args *byte) (n uint32, err error) = FormatMessageW
 //sys	ExitProcess(exitcode uint32)
 //sys	createFile(name *uint16, access uint32, mode uint32, sa *SecurityAttributes, createmode uint32, attrs uint32, templatefile int32) (handle Handle, err error) [failretval == InvalidHandle || e1 == ERROR_ALREADY_EXISTS ] = CreateFileW
@@ -354,6 +354,14 @@ func NewCallbackCDecl(fn any) uintptr {
 
 // syscall interface implementation for other packages
 
+// GetVersion reads ntdll!RtlGetNtVersionNumbers, which the compatibility shim
+// does not reach (it reports Windows 8 to an image stamped 6.1).
+func GetVersion() (ver uint32, err error) {
+	var major, minor, build uint32
+	rtlGetNtVersionNumbers(&major, &minor, &build)
+	return major | minor<<8 | (build&0xffff)<<16, nil
+}
+
 func makeInheritSa() *SecurityAttributes {
 	var sa SecurityAttributes
 	sa.Length = uint32(unsafe.Sizeof(sa))
