From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 11:18:21 +1300
Subject: [PATCH] runtime, syscall: fall back to loading system DLLs by absolute path

The runtime and syscall load system DLLs with the LoadLibraryExW flag
LOAD_LIBRARY_SEARCH_SYSTEM32, which Windows 7 knows only with update
KB2533623. Go 1.21 stopped checking whether the flag works (CL 463842,
commit a17d959).

Let programs start on Windows 7 without that update. Where the flag is
refused, load system DLLs by their full path in the system directory.

	                       before                 after
	-----------------------------------------------------------------------
	Windows 7 without      every program dies     programs start
	KB2533623              at startup
	-----------------------------------------------------------------------
	Windows 7 with         programs start         programs start
	KB2533623, and later

Gate: query (the flag refused, each load) | Remembered: N

diff --git a/src/runtime/os_windows.go b/src/runtime/os_windows.go
index d89270bc..13eb413b 100644
--- a/src/runtime/os_windows.go
+++ b/src/runtime/os_windows.go
@@ -37,6 +37,7 @@ const (
 //go:cgo_import_dynamic runtime._GetQueuedCompletionStatusEx GetQueuedCompletionStatusEx%6 "kernel32.dll"
 //go:cgo_import_dynamic runtime._GetStdHandle GetStdHandle%1 "kernel32.dll"
 //go:cgo_import_dynamic runtime._GetSystemDirectoryA GetSystemDirectoryA%2 "kernel32.dll"
+//go:cgo_import_dynamic runtime._GetSystemDirectoryW GetSystemDirectoryW%2 "kernel32.dll"
 //go:cgo_import_dynamic runtime._GetSystemInfo GetSystemInfo%1 "kernel32.dll"
 //go:cgo_import_dynamic runtime._GetThreadContext GetThreadContext%2 "kernel32.dll"
 //go:cgo_import_dynamic runtime._IsProcessorFeaturePresent IsProcessorFeaturePresent%1 "kernel32.dll"
@@ -95,6 +96,7 @@ var (
 	_GetQueuedCompletionStatusEx,
 	_GetStdHandle,
 	_GetSystemDirectoryA,
+	_GetSystemDirectoryW,
 	_GetSystemInfo,
 	_GetThreadContext,
 	_IsProcessorFeaturePresent,
@@ -246,7 +248,26 @@ func windows_GetSystemDirectory() string {
 
 func windowsLoadSystemLib(name []uint16) uintptr {
 	const _LOAD_LIBRARY_SEARCH_SYSTEM32 = 0x00000800
-	return stdcall(_LoadLibraryExW, uintptr(unsafe.Pointer(&name[0])), 0, _LOAD_LIBRARY_SEARCH_SYSTEM32)
+	const _ERROR_INVALID_PARAMETER = 87
+	h := stdcall(_LoadLibraryExW, uintptr(unsafe.Pointer(&name[0])), 0, _LOAD_LIBRARY_SEARCH_SYSTEM32)
+	// Only ERROR_INVALID_PARAMETER (Windows 7 without KB2533623) goes by path,
+	// since a load by path searches the program's directory first.
+	if h == 0 && getlasterror() == _ERROR_INVALID_PARAMETER {
+		h = loadSystemLibFromSysDir(name)
+	}
+	return h
+}
+
+func loadSystemLibFromSysDir(name []uint16) uintptr {
+	// name is NUL-terminated, so path is too.
+	var path [_MAX_PATH + 1]uint16
+	l := stdcall(_GetSystemDirectoryW, uintptr(unsafe.Pointer(&path[0])), uintptr(len(path)-1))
+	if l == 0 || l+1+uintptr(len(name)) > uintptr(len(path)) {
+		return 0
+	}
+	path[l] = '\\'
+	copy(path[l+1:], name)
+	return stdcall(_LoadLibraryExW, uintptr(unsafe.Pointer(&path[0])), 0, 0)
 }
 
 //go:linkname windows_QueryPerformanceCounter internal/syscall/windows.QueryPerformanceCounter
diff --git a/src/syscall/dll_windows.go b/src/syscall/dll_windows.go
index 9d779869..8a91d794 100644
--- a/src/syscall/dll_windows.go
+++ b/src/syscall/dll_windows.go
@@ -14,10 +14,12 @@ import (
 // Use double underscore to avoid name collision autogenerated functions.
 //go:cgo_import_dynamic syscall.__LoadLibraryExW LoadLibraryExW%3 "kernel32.dll"
 //go:cgo_import_dynamic syscall.__GetProcAddress GetProcAddress%2 "kernel32.dll"
+//go:cgo_import_dynamic syscall.__GetSystemDirectoryW GetSystemDirectoryW%2 "kernel32.dll"
 
 var (
-	__LoadLibraryExW unsafe.Pointer
-	__GetProcAddress unsafe.Pointer
+	__LoadLibraryExW      unsafe.Pointer
+	__GetProcAddress      unsafe.Pointer
+	__GetSystemDirectoryW unsafe.Pointer
 )
 
 // DLLError describes reasons for DLL load failures.
@@ -137,6 +139,20 @@ func getprocaddress(handle uintptr, procname *uint8) (uintptr, Errno) {
 	return proc, err
 }
 
+func loadSystemDLLByPath(name string) (uintptr, Errno) {
+	var b [MAX_PATH]uint16
+	r, _, _ := SyscallN(uintptr(__GetSystemDirectoryW), uintptr(unsafe.Pointer(&b[0])), uintptr(len(b)))
+	l := uint32(r)
+	if l == 0 || l >= uint32(len(b)) {
+		return 0, ERROR_MOD_NOT_FOUND
+	}
+	namep, err := UTF16PtrFromString(UTF16ToString(b[:l]) + `\` + name)
+	if err != nil {
+		return 0, ERROR_MOD_NOT_FOUND
+	}
+	return loadlibrary(namep)
+}
+
 // A DLL implements access to a single DLL.
 type DLL struct {
 	Name   string
@@ -160,6 +176,11 @@ func LoadDLL(name string) (*DLL, error) {
 	var e Errno
 	if sysdll.IsSystemDLL[name] {
 		h, e = loadsystemlibrary(namep)
+		// Only a refused LOAD_LIBRARY_SEARCH_SYSTEM32 goes by path, since a
+		// load by path searches the program's directory first.
+		if h == 0 && e == _ERROR_INVALID_PARAMETER {
+			h, e = loadSystemDLLByPath(name)
+		}
 	} else {
 		h, e = loadlibrary(namep)
 	}
