From: Vorapol Rinsatitnon <vorapol.r@pm.me>
Date: Mon, 26 Oct 2026 13:06:04 +1300
Subject: [PATCH] internal/poll: do not skip the completion port for datagram sockets

Since Go 1.21 a UDP socket skips the completion notice of a read that
finishes at once (CL 463839, commit 932d0ae). On Windows 7 a read into a
buffer too small for the datagram already waiting is reported as still
pending, and then never finishes.

Stop such a read from hanging on Windows 7. Keep the notice for UDP sockets
there.

	                       before                 after
	-----------------------------------------------------------------------
	Windows 7              such a read hangs      it returns, truncated
	                       forever
	-----------------------------------------------------------------------
	Windows 8 and later    it returns, truncated  it returns, truncated

Gate: version (Windows 7) | Remembered: Y

diff --git a/src/internal/poll/fd_windows.go b/src/internal/poll/fd_windows.go
index e077f388..6aee5ecf 100644
--- a/src/internal/poll/fd_windows.go
+++ b/src/internal/poll/fd_windows.go
@@ -55,6 +55,13 @@ func checkSetFileCompletionNotificationModes() {
 	socketCanUseSetFileCompletionNotificationModes = true
 }
 
+// truncatedRecvSkipsCompletion reports whether a pending receive that then
+// truncates posts no completion, as on Windows 7.
+var truncatedRecvSkipsCompletion = sync.OnceValue(func() bool {
+	major, minor, _ := windows.KernelVersion()
+	return major == 6 && minor < 2
+})
+
 // InitWSA initiates the use of the Winsock DLL by the current process.
 // It is called from the net package at init time to avoid
 // loading ws2_32.dll when net is not used.
@@ -503,10 +510,14 @@ func (fd *FD) Init(net string, pollable bool) error {
 	}
 	if !fd.KeepFileCompletionModes && (fd.kind != kindNet || socketCanUseSetFileCompletionNotificationModes) {
 		// Non-socket handles can use SetFileCompletionNotificationModes without problems.
-		err := syscall.SetFileCompletionNotificationModes(fd.Sysfd,
-			syscall.FILE_SKIP_SET_EVENT_ON_HANDLE|syscall.FILE_SKIP_COMPLETION_PORT_ON_SUCCESS,
-		)
-		fd.skipSyncNotif = err == nil
+		modes := uint8(syscall.FILE_SKIP_SET_EVENT_ON_HANDLE | syscall.FILE_SKIP_COMPLETION_PORT_ON_SUCCESS)
+		if fd.kind == kindNet && truncatedRecvSkipsCompletion() && !fd.IsStream {
+			// It's not safe to skip completion notifications for UDP:
+			// https://docs.microsoft.com/en-us/archive/blogs/winserverperformance/designing-applications-for-high-performance-part-iii
+			modes = syscall.FILE_SKIP_SET_EVENT_ON_HANDLE
+		}
+		err := syscall.SetFileCompletionNotificationModes(fd.Sysfd, modes)
+		fd.skipSyncNotif = err == nil && modes&syscall.FILE_SKIP_COMPLETION_PORT_ON_SUCCESS != 0
 	}
 	return nil
 }
